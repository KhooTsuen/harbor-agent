{
  "name": "harbor-agent",
  "private": true,
  "version": "1.19.0",
  "description": "本地优先的个人 AI Agent 工作台：任务台账、计划与进度、可恢复、可暂停、数据全在本机",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "package": "npm run build && node scripts/build-portable.mjs",
    "release:zip": "node scripts/release-zip.mjs",
    "cleanup:heavy": "node scripts/cleanup-heavy.mjs",
    "cleanup:release": "node scripts/cleanup-heavy.mjs --release",
    "test": "node scripts/selftest.mjs",
    "test:app": "electron . --self-test",
    "shot": "node tools/shot.mjs",
    "shot:electron": "node tools/shot-electron.mjs",
    "pty:check": "node scripts/pty-check.cjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "check:lines": "node tools/line-limit.mjs",
    "verify": "npm run typecheck && npm run lint && npm run check:lines && npm run test:unit && npm test && npm run build",
    "acceptance": "node tools/acceptance.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.454.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.6.4",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "electron": "^44.3.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "productName": "Harbor",
    "appId": "dev.harbor.agent"
  }
}
