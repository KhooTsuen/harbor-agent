# ══════════════════════════════════════════════════════════════
#  .gitignore
#
#  这个仓库一直没 init git，所以之前没有它。但只要哪天要用版本管理
#  （或者把项目交给别人），下面这些**必须**别进去。
#
#  坑记一笔：gitignore 只认 `#` 注释。写成 `/* ... */` 会被当成
#  「匹配根目录下所有东西」的**模式** —— 第一版就写错了一次。
# ══════════════════════════════════════════════════════════════

# 依赖
node_modules/

# 构建产物（能随时重新生成）
dist/
build/
dist-portable/

# ── 运行时数据：绝不提交 ──
# data/ 里有：会话、记忆、凭证库、审计日志、任务、改动快照、备份。
# 前三个是隐私，后几个是本机状态；data/workspace/ 还是 Agent 的工作目录，
# 里面可能是任意代码。
data/

# 截图（工具生成的，需要时重跑 npm run shot）
shots/

# 本地环境变量（.env.example 要提交，.env 不要）
.env
.env.local
.env.*.local

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini

# 临时文件
# 项目里真出现过 `NUL` 和 `.preview.log` 这类意外产物。
# NUL 那条尤其值得记：某条命令想重定向到 Windows 的 NUL 设备，
# 结果在 bash 下建了个**同名文件**。
*.log
NUL
tmp_*
*.tmp

# 临时工作目录。注意 `tmp/` 和上面的 `tmp_*` 是两回事 ——
# `tmp_*` 只匹配「tmp_ 开头」，盖不住这个目录，
# 于是验证脚本的产物（备份文件、探针脚本）会被 `git add -A` 一起提交。
tmp/
# 一次性的排查脚本（核实完之后没有保留价值）
tools/import-rikkahub.py

# 截图工具每次跑都会建一个新的 Chrome 临时 profile（按端口命名），
# 不会自己删 —— 攒了 10 个就有近 500MB。
.chrome-profile-*/
.chrome.log
.chrome-path

# 破坏性测试：隔离环境与备份（都是几百 MB 的整目录副本）
test-env/
backups/
