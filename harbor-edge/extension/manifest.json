{
  "manifest_version": 3,
  "name": "Harbor Browser Companion",
  "version": "0.4.0",
  "description": "Harbor side panel (Phase 3a: session list via bidirectional channel)",
  "permissions": ["nativeMessaging", "sidePanel", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Harbor"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
