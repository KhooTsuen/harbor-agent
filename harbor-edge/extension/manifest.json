{
  "manifest_version": 3,
  "name": "Harbor Browser Companion",
  "version": "0.3.0",
  "description": "Harbor side panel (Phase 2: read the active page and send it to Harbor)",
  "permissions": ["nativeMessaging", "sidePanel", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Harbor"
  },
  "side_panel": {
    "default_path": "index.html"
  }
}
