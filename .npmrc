# ════════════════════════════════════════════════════════
#  npm 配置
#
#  只放**通用**设置。以前这里写了两条本机路径（cache 指向另一个项目的
#  npm 缓存、electron_config_cache 指向再一个项目的 Electron 缓存）——
#  陌生人 clone 之后 npm install 会往不存在的 E:\ 路径写，等于把
#  「开源版本不依赖作者电脑环境」这条直接违反掉。干净环境构建时抓到的。
#
#  想改缓存位置，自己加两行（或者用全局 npm config）：
#    cache=D:\\npm-cache
#    electron_config_cache=D:\\electron-cache
# ════════════════════════════════════════════════════════

# Electron 二进制走国内镜像（对国内用户友好；不需要的话删掉这两行）
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
